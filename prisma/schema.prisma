generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Auth ──────────────────────────────────────────────────────────────────────

model User {
  id                 String    @id @default(cuid())
  firstName          String
  lastName           String
  email              String    @unique
  emailVerified      DateTime?
  image              String?
  role               UserRole  @default(REP)
  branch             String?
  phone              String?
  passwordHash       String?
  profileComplete    Boolean   @default(false)
  isActive           Boolean   @default(true)
  mustChangePassword Boolean   @default(false)
  experienceLevel    String    @default("rookie")
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  accounts Account[]
  sessions Session[]
  drills   DrillSession[]
}

enum UserRole {
  REP
  MANAGER
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ── Training ──────────────────────────────────────────────────────────────────

model DrillSession {
  id           String       @id @default(cuid())
  userId       String
  drillType    DrillType
  trainingMode TrainingMode
  status       DrillStatus  @default(IN_PROGRESS)

  // Config
  objectionCore      String?
  objectionVariation String?
  intensity          String?
  scenarioJson       Json?
  phaseId            String?
  experienceLevel    String?
  scenarioHash       String?

  // Results
  overallScore Int?
  criteriaJson Json?
  bestMoment   String?
  fixThis      String?
  oneLiner     String?

  // Transcript
  transcript Message[]

  startedAt   DateTime  @default(now())
  completedAt DateTime?
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum DrillType {
  OBJECTION
  WALKTHROUGH
}

enum TrainingMode {
  TIMEPROOF
  NEPQ
}

enum DrillStatus {
  IN_PROGRESS
  COMPLETED
  ABANDONED
}

model Message {
  id        String   @id @default(cuid())
  sessionId String
  role      String
  content   String
  hint      String?
  phase     String?
  createdAt DateTime @default(now())

  session DrillSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
